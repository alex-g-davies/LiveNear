# Copy to .env and fill in. .env is gitignored and read ONLY on the backend.

# Mapbox token (isochrone, geocoding, directions scopes). Blank in local dev
# serves the committed isochrone fixture instead of calling Mapbox
# (fixture-first mode); blank in production (STATIC_DIR set) makes the commute
# endpoints return 503 rather than a fake contour (spec 021). NEVER expose this
# in the frontend.
MAPBOX_TOKEN=

# Default work location the commute isochrone originates from (Museum of Flight,
# Seattle). The frontend lets users move the point interactively; this is the
# server-side fallback when the client sends no lat/lon.
WORK_LAT=47.5180
WORK_LON=-122.2966

# Drive-time contour in minutes.
CONTOUR_MINUTES=30

# Force serving the committed fixture even if MAPBOX_TOKEN is set (offline
# dev, the CI Docker smoke test). Defaults to false; auto-true when no token is
# present AND STATIC_DIR is unset (local dev only).
USE_FIXTURE=false

# --- Hardening (spec 004) ---

# Hard daily cap on upstream Mapbox calls (isochrone scenarios + geocodes).
# Cache hits spend nothing. 0 disables the breaker.
MAPBOX_DAILY_CALL_BUDGET=2000

# Per-IP rate limits (slowapi syntax). NOTE: these are read from the PROCESS
# environment at startup (os.getenv), NOT from this .env file — set them when
# launching, e.g. in PowerShell:
#   $env:RATE_LIMIT_UPSTREAM = "20/minute"; uvicorn app.main:app --reload
# 20/minute matches production (render.yaml): dual-workplace interactions
# burst up to ~6 requests (2 isochrones + commutes + reverse geocodes).
# RATE_LIMIT_UPSTREAM=10/minute (default)
# RATE_LIMIT_DATA=60/minute (default)

# CORS origins as a JSON list. Only matters for split-origin dev; in production
# the SPA is served same-origin by the backend (spec 006).
# CORS_ORIGINS=["http://localhost:5173"]

# "text" (default) or "json" — single-line JSON logs for cloud ingestion.
LOG_FORMAT=text

# --- Cars module (spec 022) ---

# Private listings + raw snapshots live in the owner's Cloudflare R2 bucket
# (S3-compatible). All four must be set for the app to load listings; with
# none set, local dev serves the committed synthetic fixture and production
# reports listings "unavailable" on /api/health. Never commit real values.
CARS_R2_ACCOUNT_ID=
CARS_R2_ACCESS_KEY_ID=
CARS_R2_SECRET_ACCESS_KEY=
CARS_R2_BUCKET=
# Key of the consolidated listings CSV inside the bucket.
CARS_R2_LISTINGS_KEY=listings/listings.csv
# Salt for hashing registration numbers / ad ids before storage.
CARS_HASH_SALT=change-me
# Statens vegvesen vehicle-data API key (free, via BankID). Ingestion only.
CARS_VEGVESEN_API_KEY=
# Per-IP limit for POST /api/cars/scenarios (process env, like RATE_LIMIT_*).
# CARS_SCENARIO_LIMIT=30/minute (default)

# --- Data build only (spec 008; not read by the app) ---

# Free Census API key for scripts/build_data.py ACS enrichment (population /
# median income). Sign up: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
